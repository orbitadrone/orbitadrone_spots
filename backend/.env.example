# Puerto opcional
# PORT=3000

# Bunny Stream
BUNNY_LIBRARY_ID=your_library_id
BUNNY_STREAM_API_KEY=your_stream_api_key
BUNNY_CDN_HOST=https://your-library-id.b-cdn.net
# Secreto opcional para proteger el webhook Bunny.
# Configura Bunny con una URL como:
# https://tu-backend.example.com/bunny/webhook?token=ESTE_SECRETO
BUNNY_WEBHOOK_TOKEN=

# Firebase (para verificar ID tokens en las subidas)
# Pon en "false" para pruebas locales sin auth.
FIREBASE_AUTH_REQUIRED=true

# Elige una de las tres formas de credenciales:
# 1) Cadena JSON completa:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
#
# 2) Campos sueltos:
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# 3) Ruta a un archivo JSON (ADC):
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/service-account.json
